{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets baseUrl, which TypeScript 6 rejects as deprecated and 7 removes.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
